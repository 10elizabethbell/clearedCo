  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Gold pill for every main action; ink text.",
      "html": "<button class=\"ds-btn-primary\">Get a free quote</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;padding:0 26px;border-radius:999px;font:400 18px/1 \"Cal Sans\",\"Avenir Next\",\"Segoe UI\",system-ui,sans-serif;background:#f5c451;color:#1f1a46;border:2px solid #f5c451;cursor:pointer;transition:background-color .2s,border-color .2s,transform .12s}.ds-btn-primary:hover{background:#f8d47c;border-color:#f8d47c}.ds-btn-primary:focus-visible{outline:3px solid #5a4fc0;outline-offset:3px}.ds-btn-primary:active{transform:scale(.98)}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Second action on the hero, over indigo.",
      "html": "<div class=\"ds-ghost-wrap\"><button class=\"ds-btn-ghost\">See our work</button></div>",
      "css": ".ds-ghost-wrap{background:#1c1840;padding:20px}.ds-btn-ghost{display:inline-flex;align-items:center;min-height:56px;padding:0 26px;border-radius:999px;font:400 18px/1 \"Cal Sans\",\"Avenir Next\",\"Segoe UI\",system-ui,sans-serif;background:transparent;color:#f5f4fb;border:2px solid rgba(245,244,251,.7);cursor:pointer;transition:background-color .2s,border-color .2s,transform .12s}.ds-btn-ghost:hover{border-color:#fff;background:rgba(255,255,255,.1)}.ds-btn-ghost:focus-visible{outline:3px solid #f5c451;outline-offset:3px}.ds-btn-ghost:active{transform:scale(.98)}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Tinted borderless field on the white form card.",
      "html": "<label class=\"ds-label\">Your name<input class=\"ds-input\" type=\"text\" placeholder=\"First name is fine\"></label>",
      "css": ".ds-label{display:grid;gap:8px;font:400 17px/1.2 \"Cal Sans\",\"Avenir Next\",\"Segoe UI\",system-ui,sans-serif;color:#1f1a46;background:#fff;padding:24px;border-radius:24px}.ds-input{width:100%;font:16px/1.4 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;color:#1f1a46;background:#e8e6f4;border:2px solid transparent;border-radius:10px;padding:13px 14px;min-height:52px;caret-color:#2e2768;transition:border-color .15s}.ds-input::placeholder{color:#55507a}.ds-input:hover,.ds-input:focus{outline:none;border-color:#5a4fc0}"
    },
    {
      "name": "Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pick what needs cleaning; selected fills ink.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\">Windows, outside</button><button class=\"ds-chip is-on\">Driveway</button><button class=\"ds-chip\">Deck</button></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:10px;background:#fff;padding:20px;border-radius:24px}.ds-chip{display:inline-flex;align-items:center;min-height:48px;padding:0 18px;border-radius:999px;background:#e8e6f4;border:2px solid transparent;font:16px/1 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;color:#1f1a46;cursor:pointer;transition:border-color .15s,background-color .15s,color .15s}.ds-chip:hover,.ds-chip:focus-visible{border-color:#5a4fc0;outline:none}.ds-chip.is-on{background:#1f1a46;color:#fff}.ds-chip.is-on:focus-visible{outline:3px solid #5a4fc0;outline-offset:2px}"
    },
    {
      "name": "Header",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Slim paper header: logo and wordmark left, Message us right. Not sticky.",
      "html": "<header class=\"ds-top\"><a class=\"ds-brand\" href=\"#\"><span class=\"ds-logo\"></span><span><b>ClearedCo</b><small>Canfield, Ohio</small></span></a><a class=\"ds-tel\" href=\"#\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M12 2C6.4 2 2 6.1 2 11.4c0 2.9 1.3 5.4 3.4 7.1V22l3.2-1.8c1.1.3 2.2.5 3.4.5 5.6 0 10-4.1 10-9.3S17.6 2 12 2z\"/></svg>Message us</a></header>",
      "css": ".ds-top{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:64px;padding:0 20px;background:#f5f4fb;color:#1f1a46}.ds-brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit;line-height:1}.ds-logo{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#1f1a46,#6f64b8)}.ds-brand b{display:block;font:400 21px/1 \"Cal Sans\",\"Avenir Next\",\"Segoe UI\",system-ui,sans-serif;letter-spacing:.01em}.ds-brand small{display:block;font:600 11px/1 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:#55507a;margin-top:5px}.ds-tel{display:inline-flex;align-items:center;gap:8px;min-height:44px;font:400 17px/1 \"Cal Sans\",\"Avenir Next\",\"Segoe UI\",system-ui,sans-serif;color:inherit;text-decoration:none}.ds-tel svg{width:20px;height:20px;color:#6f64b8}.ds-tel:hover{color:#5a4fc0}"
    },
    {
      "name": "Service Row",
      "kind": "custom",
      "refersTo": "service-row",
      "description": "A service as a plain row on indigo; only the arrow changes on hover.",
      "html": "<div class=\"ds-band\"><a class=\"ds-row\" href=\"#\">House washing<span class=\"ds-arrow\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 12h14M13 6l6 6-6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></span></a></div>",
      "css": ".ds-band{background:#2e2768;padding:20px}.ds-row{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:64px;padding:10px 12px 10px 22px;background:rgba(255,255,255,.06);border-radius:18px;color:#f5f4fb;text-decoration:none;font:400 20px/1.2 \"Cal Sans\",\"Avenir Next\",\"Segoe UI\",system-ui,sans-serif}.ds-row:hover,.ds-row:focus-visible{outline:none;background:rgba(255,255,255,.06)}.ds-arrow{width:44px;height:44px;flex:none;border-radius:50%;display:grid;place-items:center;background:rgba(255,255,255,.1);color:#f5f4fb;transition:background-color .2s,color .2s}.ds-arrow svg{width:18px;height:18px}.ds-row:hover .ds-arrow{background:#f5c451;color:#1f1a46}.ds-row:focus-visible .ds-arrow{background:#f5c451;color:#1f1a46;outline:3px solid #f5c451;outline-offset:3px}"
    },
    {
      "name": "Before / After Slider",
      "kind": "custom",
      "refersTo": "slider-knob",
      "description": "Real before/after pair with a plain gold divider and round gold knob.",
      "html": "<div class=\"ds-ba\"><span class=\"ds-tag\">Before</span><span class=\"ds-tag ds-tag-r\">After</span><span class=\"ds-line\"><span class=\"ds-knob\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 6l-5 6 5 6M15 6l5 6-5 6\"/></svg></span></span></div>",
      "css": ".ds-ba{position:relative;height:260px;border-radius:24px;overflow:hidden;background:linear-gradient(90deg,#55507a 0 50%,#cfcaf0 50% 100%);cursor:ew-resize}.ds-tag{position:absolute;top:14px;left:14px;font:500 13px/1 -apple-system,BlinkMacSystemFont,\"Segoe UI\",\"Helvetica Neue\",Arial,sans-serif;letter-spacing:.04em;color:#fff;background:rgba(28,24,64,.6);padding:7px 10px;border-radius:8px}.ds-tag-r{left:auto;right:14px}.ds-line{position:absolute;top:0;bottom:0;left:50%;width:3px;margin-left:-1.5px;background:#f5c451}.ds-knob{position:absolute;top:50%;left:50%;width:44px;height:44px;margin:-22px 0 0 -22px;border-radius:50%;background:#f5c451;color:#1f1a46;display:grid;place-items:center;box-shadow:0 6px 16px -6px rgba(0,0,0,.5)}.ds-knob svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round}.ds-ba:focus-within .ds-knob{outline:3px solid #5a4fc0;outline-offset:3px}"
    },
    {
      "name": "Quote Form Card",
      "kind": "card",
      "refersTo": "form-card",
